---
layout: base.njk
title: log
permalink: /log/
---
<div class="log">
  {% if collections.entries.length %}
    <ul class="results">
      {% for entry in collections.entries %}
        <li>
          <a href="{{ entry.url }}">{{ entry.data.title }}</a>
          <span class="meta">
            {% if loop.first %}<span class="latest">latest</span>{% endif %}
            <time datetime="{{ entry.date | dateFormat }}">{{ entry.date | dateDisplay }}</time>
          </span>
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <p class="empty">no entries.</p>
  {% endif %}
</div>
