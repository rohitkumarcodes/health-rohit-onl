---
layout: base.njk
title: log
permalink: /log/
---
<div class="log">
  {% set older = collections.entries.slice(1) %}
  {% if older.length %}
    <ul class="results">
      {% for entry in older %}
        <li>
          <time datetime="{{ entry.date | dateFormat }}">{{ entry.date | dateShort }}</time>
          <a href="{{ entry.url }}">{{ entry.data.title }}</a>
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <p class="empty">no older entries.</p>
  {% endif %}
</div>
