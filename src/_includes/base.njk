<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} - {% endif %}{{ site.name }}</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="page">
    <header class="global-header">
      <a class="logo" href="/">{{ site.name }}</a>
      <nav class="crumbs" aria-label="breadcrumb">
        <a href="/">CL</a>
        &gt;
        <a href="/">health</a>
        {%- if crumb %}
        &gt; <span>{{ crumb }}</span>
        {%- endif %}
      </nav>
      <nav class="top-links">
        <a href="/">home</a>
        <span class="sep">|</span>
        <a href="/log/">log</a>
      </nav>
    </header>

    <main>
      {{ content | safe }}
    </main>

    <footer class="site-footer">
      {{ site.name }} &mdash; {{ site.tagline }}
    </footer>
  </div>
</body>
</html>
