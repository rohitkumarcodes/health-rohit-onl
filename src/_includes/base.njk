<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} - {% endif %}{{ site.name }}</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="page">
    <header class="global-header">
      <a class="logo" href="/">{{ site.name }}</a>
      <nav class="top-links">
        <a href="/log/">log</a>
      </nav>
    </header>

    <main>
      {{ content | safe }}
    </main>
  </div>
</body>
</html>
