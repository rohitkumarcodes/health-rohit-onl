<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} - {% endif %}{{ site.name }}</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="page">
    <header class="global-header">
      <div class="brand">
        {% if page.url == "/" %}
          <span class="logo">{{ site.name }}</span>
        {% else %}
          <a class="logo" href="/">{{ site.name }}</a>
        {% endif %}
        <span class="tagline">{{ site.tagline }}</span>
      </div>
      <nav class="top-links">
        {% if page.url == "/log/" %}
          <span class="current">log</span>
        {% else %}
          <a href="/log/">log</a>
        {% endif %}
      </nav>
    </header>

    <main>
      {{ content | safe }}
    </main>
  </div>
</body>
</html>
